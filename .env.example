# ---------------------------------------------------------------------------
# Where the console sends its API requests.
#
# EMPTY  = same origin. Requests go to /v1/... on whatever host serves the app,
#          and the Vite dev proxy (below) forwards them. Recommended: the
#          browser never makes a cross-origin request, so CORS cannot fail.
# A URL  = used as-is, e.g. http://localhost:8000 to hit a local backend direct.
#
# UNSET is a boot error, on purpose. The console will not guess a backend, and
# it will never fall back to a production URL.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=

# Where the Vite dev/preview proxy forwards /v1, /healthz and /readyz.
# `make up` in the backend repo serves this.
VITE_API_PROXY_TARGET=http://localhost:8000

# Machine-integration screen. Keep false for anything a client will see.
VITE_ENABLE_SIMULATOR=false

# Serve every endpoint from MSW fixtures so the UI demos with the backend down.
# MUST be false anywhere real: mock data that nobody notices is worse than an
# outage. When it is on, the header says so in red — that banner is deliberate.
VITE_USE_MSW=false
